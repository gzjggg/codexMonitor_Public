+++ b/codex-rs/codex-api/src/model_probe_tests.rs
@@ -0,0 +1,29 @@
+use super::*;
+
+#[test]
+fn records_only_models_and_keeps_request_response_correlated() {
+    let path =
+        std::env::temp_dir().join(format!("codex-model-probe-test-{}.jsonl", Uuid::new_v4()));
+    let mut probe = ModelProbe {
+        path: path.clone(),
+        metadata: json!({"id": "attempt-1", "requested_model": "requested"}),
+        observed: (None, None),
+    };
+    probe.sent(Some("header-model"));
+    probe.response(
+        Some(&json!({"model": "declared", "output": "PRIVATE"})),
+        Some("header-model"),
+    );
+    probe.response(Some(&json!({"model": "declared"})), Some("header-model"));
+    let text = std::fs::read_to_string(&path).expect("probe log");
+    std::fs::remove_file(path).expect("remove test log");
+    let records: Vec<Value> = text
+        .lines()
+        .map(|line| serde_json::from_str(line).expect("JSON"))
+        .collect();
+    assert_eq!(records.len(), 2);
+    assert_eq!(records[0]["id"], records[1]["id"]);
+    assert_eq!(records[1]["response_model"], "declared");
+    assert_eq!(records[1]["server_model"], "header-model");
+    assert!(!text.contains("PRIVATE"));
+}
