diff --git a/codex-rs/codex-api/src/model_probe.rs b/codex-rs/codex-api/src/model_probe.rs
new file mode 100644
index 0000000..c688917
--- /dev/null
+++ b/codex-rs/codex-api/src/model_probe.rs
@@ -0,0 +1,91 @@
+//! Opt-in metadata-only model audit; never changes a request or response.
+
+use serde_json::Value;
+use serde_json::json;
+use std::fs::OpenOptions;
+use std::io::Write;
+use std::path::PathBuf;
+use std::time::SystemTime;
+use std::time::UNIX_EPOCH;
+use uuid::Uuid;
+
+pub struct ModelProbe {
+    path: PathBuf,
+    metadata: Value,
+    observed: (Option<String>, Option<String>),
+}
+
+impl ModelProbe {
+    pub(crate) fn new(
+        requested_model: &str,
+        thread_id: Option<&str>,
+        turn_id: Option<&str>,
+        transport: &str,
+        warmup: bool,
+    ) -> Option<Self> {
+        let path = std::env::var_os("CODEX_MODEL_PROBE_PATH")?;
+        if path.is_empty() {
+            return None;
+        }
+        Some(Self {
+            path: PathBuf::from(path),
+            metadata: json!({
+                "id": Uuid::new_v4().to_string(),
+                "requested_model": requested_model,
+                "thread_id": thread_id,
+                "turn_id": turn_id,
+                "transport": transport,
+                "warmup": warmup,
+            }),
+            observed: (None, None),
+        })
+    }
+
+    pub(crate) fn sent(&self, server_model: Option<&str>) {
+        self.record("request", /*response_model*/ None, server_model);
+    }
+
+    pub(crate) fn response(&mut self, response: Option<&Value>, server_model: Option<&str>) {
+        let response_model = response
+            .and_then(|value| value.get("model"))
+            .and_then(Value::as_str);
+        let observed = (
+            response_model.map(str::to_owned),
+            server_model.map(str::to_owned),
+        );
+        if observed != (None, None) && observed != self.observed {
+            self.record("response", response_model, server_model);
+            self.observed = observed;
+        }
+    }
+
+    fn record(&self, phase: &str, response_model: Option<&str>, server_model: Option<&str>) {
+        let mut event = self.metadata.clone();
+        event["phase"] = json!(phase);
+        event["time"] = json!(
+            SystemTime::now()
+                .duration_since(UNIX_EPOCH)
+                .unwrap_or_default()
+                .as_secs_f64()
+        );
+        event["response_model"] = json!(response_model);
+        event["server_model"] = json!(server_model);
+        let result = (|| -> std::io::Result<()> {
+            // ponytail: a short file lock per metadata line; use a writer queue if audit I/O becomes measurable.
+            let mut file = OpenOptions::new()
+                .create(true)
+                .read(true)
+                .append(true)
+                .open(&self.path)?;
+            file.lock()?;
+            writeln!(file, "{event}")
+        })();
+        if let Err(error) = result {
+            tracing::warn!(%error, "model probe could not append metadata");
+        }
+    }
+}
+
+#[cfg(test)]
+#[path = "model_probe_tests.rs"]
+mod tests;
